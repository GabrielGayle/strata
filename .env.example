# "Depth from photo" endpoint: the Modal worker in promptda-depth-generator
# (modal deploy modal_app/worker.py prints the strata-depth URL; add /strata).
VITE_DEPTH_URL=

# Owner passphrase for cloud projects (server only — never prefix with VITE_).
# The browser stores what you type after you enter it once in Projects.
STRATA_OWNER_TOKEN=

# cockpit yoga sign-in (the Supabase project shared with lace and cockpit.yoga). The url and
# anon key are public (the browser needs them); STRATA_OWNER_EMAILS is the server's list of
# accounts allowed into cloud projects and Boost, comma-separated. Unset: passphrase only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
STRATA_OWNER_EMAILS=

# Optional file-backed project store for local / e2e when Vercel Blob isn't set.
STRATA_PROJECTS_DIR=

# Boost (cloud jobs on Modal, plan PR 8). Server only, never VITE_-prefixed; set them in Vercel.
# The URL of the Modal web API, printed by `modal deploy worker/app.py` (…--strata-cloud-api.modal.run).
MODAL_GEO_URL=
# A Modal proxy auth token (Modal dashboard > Settings > Proxy Auth Tokens): its ID and secret.
MODAL_KEY=
MODAL_SECRET=
# The private Blob store `strata-render-cache` (env prefix RENDER_CACHE). Connected the token-less
# way, Vercel sets RENDER_CACHE_STORE_ID and the site uses OIDC; otherwise give its read/write token.
RENDER_CACHE_STORE_ID=
# Falls back to BLOB_READ_WRITE_TOKEN (the projects store) when unset. The same value goes in
# the Modal secret "strata-cloud", where the worker writes results with it.
RENDER_CACHE_READ_WRITE_TOKEN=
